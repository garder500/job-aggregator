NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=http://localhost:3001
# Use long random values. Production refuses development credentials.
APP_PASSWORD=
SESSION_SECRET=
DATABASE_URL=postgres://job:replace-db-password@postgres:5432/jobs
POSTGRES_PASSWORD=replace-db-password
DATA_DIR=/data
SESSIONS_DIR=/sessions
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Set a conservative upper bound per call in EUR for the selected model.
AI_CALL_RESERVE_EUR=0.05
BACKUP_AGE_RECIPIENT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=
S3_BUCKET=
