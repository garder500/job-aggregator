{
  "name": "job-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "api": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "runner": "tsx src/runner-main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src web scripts tests *.ts *.json *.yaml README.md examples",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "migrate": "tsx src/migrate.ts",
    "sessions": "tsx scripts/session.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.3.1",
    "@tanstack/react-query": "^5.90.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "graphile-worker": "^0.16.6",
    "imapflow": "^1.0.195",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.544.0",
    "mailparser": "^3.7.4",
    "pg": "^8.16.3",
    "playwright": "^1.55.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rss-parser": "^3.13.0",
    "tsx": "^4.20.6",
    "undici": "^7.16.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.55.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "embedded-postgres": "18.4.0-beta.17",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18"
  }
}
